# Destino del proxy de /api en desarrollo. Copiar a .env.local para cambiarlo.
API_PROXY_TARGET=http://localhost:8080
# Origen de la API para el build. En desarrollo se deja sin definir (usa el proxy); el de
# produccion esta en .env.production. No poner secretos en variables VITE_: son publicas.
# VITE_API_BASE_URL=https://api.servibox.co
